# URL of the backend API in ./backend — must include the /api prefix.
# Use your computer's LAN IP (not localhost) when testing on a physical device.
EXPO_PUBLIC_API_URL=https://api.randompick.prahladsingh.in/api

# Use React Native's native fetch instead of Expo's own — needed for
# multipart photo uploads to work correctly on SDK 57 (see backend issue).
EXPO_PUBLIC_USE_RN_FETCH=1
