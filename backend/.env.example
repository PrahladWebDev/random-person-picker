# MongoDB
# Local: mongodb://127.0.0.1:27017/randompick
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/randompick
MONGODB_URI=mongodb://127.0.0.1:27017/randompick

# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Server
PORT=4000
